CVspread_toolconfig: {
	tool_type: "CVspread"
	instance_name: "CentralValueSpreadFromGENIE"

	reference: { 
      name: "GENIE"
      input: "GENIE.templates.root"
      configurations: [ 
        { tgt: 1000180400 probe: "numu" },
        { tgt: 1000080160 probe: "numu" },
        { tgt: 1000060120 probe: "numu" },
      ]
  }

  alternate_models: [
    { name: "NEUT"
      input: "NEUT.templates.root"
      # if no configurations supplied, assumed matches reference
    },
    { name: "NuWro"
      input: "NuWro.templates.root"
      configurations: [ 
        { tgt: 1000180400 probe: "numu" },
        { tgt: 1000080160 probe: "numu" },
        { tgt: 1000060120 probe: "numu" },
      ]
    }
  ]

	verbosity_level: 5
}

syst_providers: [CVspread_toolconfig]